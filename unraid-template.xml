<?xml version="1.0"?>
<Container version="2">
  <Name>Hubismart</Name>
  <Repository>ghcr.io/pedrogvm97/hubismart:latest</Repository>
  <Registry>https://ghcr.io/</Registry>
  <Network>host</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/pedrogvm97/Hubismart/issues</Support>
  <Project>https://github.com/pedrogvm97/Hubismart</Project>
  <Overview>Hubismart - Smart Home and EZVIZ Surveillance Camera Manager.</Overview>
  <Category>Security: HomeAutomation:</Category>
  <WebUI>http://[IP]:[PORT:3020]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/pedrogvm97/Hubismart/main/unraid-template.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/pedrogvm97/Hubismart/main/client/public/logo.svg</Icon>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1773095431</DateInstalled>
  <Description>Hubismart - Smart Home and EZVIZ Surveillance Camera Manager.</Description>
  <Networking>
    <Mode>host</Mode>
    <Publish/>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/hubismart/data</HostDir>
      <ContainerDir>/app/data</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
  </Data>
  <Environment>
    <Variable>
      <Value>3020</Value>
      <Name>PORT</Name>
      <Mode/>
    </Variable>
  </Environment>
  <Config Name="WebUI Port" Target="3020" Default="3020" Mode="tcp" Description="Port for Hubismart Web Interface" Type="Port" Display="always" Required="true" Mask="false">3020</Config>
  <Config Name="AppData" Target="/app/data" Default="/mnt/user/appdata/hubismart/data" Mode="rw" Description="Database and configuration storage" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/hubismart/data</Config>
</Container>
